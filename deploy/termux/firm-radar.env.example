# Copy to firm-radar.env (same directory) and adjust. No secrets are needed: the demo calls
# no external API and PostgreSQL is reached over localhost without a password.

# Local PostgreSQL, trust authentication on the loopback interface.
FIRM_RADAR_DATABASE_URL=postgresql+asyncpg://firm_radar@127.0.0.1:5432/firm_radar

# Public read-only demo: fictional data, no registry calls, no background jobs.
FIRM_RADAR_DEMO_MODE=true
FIRM_RADAR_DEMO_RATE_LIMIT_PER_MINUTE=60

# Every pooled connection is one PostgreSQL backend process; keep the pool small.
FIRM_RADAR_DB_POOL_SIZE=2
FIRM_RADAR_DB_MAX_OVERFLOW=2

# Read by run-demo.sh, not by the application.
HOST=127.0.0.1
PORT=8093
